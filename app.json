{
  "expo": {
    "name": "Oriona",
    "slug": "oriona",
    "owner": "olya2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fbf5f2",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbf5f2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.olyaursul.oriona",
      "supportsTablet": false,
      "buildNumber": "9",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.olyaursul.oriona",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fbf5f2"
      }
    },
    "plugins": [
      "./plugins/withNoShakeToUndo",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1ee4aba3-f8e0-4271-a51b-d24452911355"
      },
      "revenuecatIosKey": "appl_REPLACE_ME"
    }
  }
}
